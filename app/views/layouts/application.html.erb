<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prism — <%= content_for?(:title) ? yield(:title) + " | " : "" %>Observation Platform</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      /* Minimal reset + utility styles — intentionally not using a CSS framework
         so the UI is simple but not distracting from engineering work. */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
             background: #f8fafc; color: #1e293b; font-size: 15px; line-height: 1.6; }
      a { color: #4f46e5; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 1rem; }
      nav { background: #1e293b; color: #f1f5f9; padding: .75rem 1rem; }
      nav a { color: #c7d2fe; margin-right: 1.25rem; font-size: .9rem; }
      nav a:hover { color: #fff; text-decoration: none; }
      nav .brand { color: #fff; font-weight: 700; font-size: 1rem; margin-right: 2rem; }
      .content { padding: 2rem 1rem; }
      h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; }
      h2 { font-size: 1.2rem; font-weight: 600; margin: 1.5rem 0 .5rem; }
      h3 { font-size: 1rem; font-weight: 600; margin: 1rem 0 .25rem; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 6px;
              padding: 1.25rem; margin-bottom: 1rem; }
      .badge { display: inline-block; padding: .2rem .55rem; border-radius: 4px;
               font-size: .75rem; font-weight: 600; }
      .badge-draft       { background: #e2e8f0; color: #475569; }
      .badge-in_progress { background: #dbeafe; color: #1d4ed8; }
      .badge-finalized   { background: #dcfce7; color: #15803d; }
      .badge-cancelled   { background: #fee2e2; color: #dc2626; }
      .badge-concern     { background: #fee2e2; color: #dc2626; }
      .badge-mixed       { background: #fef9c3; color: #854d0e; }
      .badge-strong      { background: #dcfce7; color: #15803d; }
      .badge-not_started { background: #e2e8f0; color: #64748b; }
      .badge-in_progress { background: #dbeafe; color: #1d4ed8; }
      .badge-blocked     { background: #fee2e2; color: #dc2626; }
      .badge-done        { background: #dcfce7; color: #15803d; }
      .progress-bar-outer { background: #e2e8f0; border-radius: 4px; height: 8px; overflow: hidden; }
      .progress-bar-inner { background: #6366f1; height: 100%; transition: width .3s; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: .6rem .75rem; text-align: left; border-bottom: 1px solid #e2e8f0; }
      th { font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em;
           color: #64748b; background: #f8fafc; }
      .btn { display: inline-block; padding: .45rem 1rem; border-radius: 5px; font-size: .875rem;
             cursor: pointer; border: none; font-weight: 500; }
      .btn-primary { background: #4f46e5; color: #fff; }
      .btn-primary:hover { background: #4338ca; color: #fff; }
      .btn-danger  { background: #dc2626; color: #fff; }
      .btn-sm { padding: .3rem .65rem; font-size: .8rem; }
      .flash-notice { background: #dcfce7; color: #15803d; padding: .75rem 1rem; border-radius: 5px; margin-bottom: 1rem; }
      .flash-alert  { background: #fee2e2; color: #dc2626; padding: .75rem 1rem; border-radius: 5px; margin-bottom: 1rem; }
      .stat-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      .stat-card { flex: 1; min-width: 120px; background: #fff; border: 1px solid #e2e8f0;
                   border-radius: 6px; padding: 1rem; text-align: center; }
      .stat-card .number { font-size: 2rem; font-weight: 700; color: #4f46e5; }
      .stat-card .label  { font-size: .8rem; color: #64748b; margin-top: .2rem; }
      form label { display: block; font-weight: 500; margin-bottom: .25rem; font-size: .875rem; }
      form input[type=text], form input[type=email], form input[type=password],
      form input[type=date], form input[type=number], form select, form textarea {
        width: 100%; padding: .45rem .75rem; border: 1px solid #cbd5e1; border-radius: 4px;
        font-size: .9rem; margin-bottom: .75rem; }
      form textarea { min-height: 80px; resize: vertical; }
    </style>
  </head>
  <body>
    <%= render "shared/nav" %>
    <div class="container content">
      <% if notice.present? %><div class="flash-notice"><%= notice %></div><% end %>
      <% if alert.present?  %><div class="flash-alert"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
