<% content_for :title, "Sign in" %>
<div style="max-width:380px; margin: 5rem auto;">
  <div class="card">
    <h1 style="text-align:center; margin-bottom:1.5rem;">Sign in to Prism</h1>
    <%= form_with url: login_path, local: true do |f| %>
      <label>Email</label>
      <%= f.email_field :email, autofocus: true, placeholder: "you@example.com" %>
      <label>Password</label>
      <%= f.password_field :password, placeholder: "••••••••" %>
      <%= f.submit "Sign in", class: "btn btn-primary", style: "width:100%; margin-top:.5rem;" %>
    <% end %>
  </div>
</div>
